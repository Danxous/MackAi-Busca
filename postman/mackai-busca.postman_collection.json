    {
      "name": "Busca",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "search"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Como esconder segredos da aplicação?\",\n  \"top_k\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"busca no contrato\", () => {",
              "  pm.expect(b).to.have.keys(\"strategy\", \"scope\", \"results\");",
              "  pm.expect([\"embedding\", \"tfidf\"]).to.include(b.strategy);",
              "  b.results.forEach(r => pm.expect(r).to.have.keys(\"source\", \"path\", \"start_line\", \"end_line\", \"similarity\", \"text\"));",
              "});"
            ]
          }
        }
      ]
    },
